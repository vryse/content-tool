ANTHROPIC_API_KEY=your-api-key
ANTHROPIC_MODEL=claude-sonnet-4-6
OPENAI_API_KEY=your-api-key
OPENAI_MODEL=gpt-4o-mini
# Used only for final draft generation and later revisions. Set to a model your
# OpenAI project can access if you need a different quality/cost trade-off.
OPENAI_WRITING_MODEL=gpt-5.6-terra
GOOGLE_API_KEY=your-api-key
GOOGLE_MODEL=gemini-3.7-flash
LLM_PROVIDER=anthropic

# Neon PostgreSQL. Paste the connection string from the Neon console as-is:
# its sslmode/channel_binding parameters are translated for asyncpg at startup.
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/vryse?sslmode=require

# Cloudflare R2 (reference document storage).
# Create an R2 API token with Object Read & Write on the bucket below.
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=vryse-references
# Optional: overrides the derived https://<account>.r2.cloudflarestorage.com endpoint.
# R2_ENDPOINT=
# Optional: key prefix inside the bucket.
# R2_PREFIX=references/

# Comma-separated browser origins. Use the exact deployed frontend origin(s),
# without paths. Localhost is allowed by default when this variable is omitted.
CORS_ORIGINS=https://vryse-editorial-studio.arupb.workers.dev/
